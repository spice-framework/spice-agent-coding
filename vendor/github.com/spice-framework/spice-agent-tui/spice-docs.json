{
  "$schema": "https://spiceframework.dev/schemas/spice-docs.schema.json",
  "schema": 1,
  "product": {
    "id": "terminal-interface",
    "title": "Terminal interface",
    "family": "agent-extension",
    "summary": "An accessible terminal interface for Spice Agent with explicit rendering, key, annotation, and lifecycle policies.",
    "maturity": "experimental",
    "audience": [
      "application-developer",
      "extension-author",
      "evaluator"
    ]
  },
  "content": [
    {
      "source": "README.md",
      "route": "index",
      "kind": "how-to",
      "order": 0,
      "search": true
    },
    {
      "source": "ARCHITECTURE.md",
      "route": "architecture",
      "kind": "concept",
      "order": 10,
      "search": true
    },
    {
      "source": "docs/**/*.md",
      "routeFrom": "docs",
      "order": 20,
      "search": true
    }
  ],
  "snippets": [
    {
      "root": ".",
      "include": [
        "**/*.go"
      ],
      "exclude": [
        "vendor/**",
        "internal/spicegen/**",
        ".generated/**"
      ]
    }
  ]
}
