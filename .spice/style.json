{
  "schemaVersion": 1,
  "profile": "java-structured",
  "sourceRoots": [
    "cmd",
    "internal/architectureproof",
    "internal/daemon",
    "internal/daemoncommand",
    "internal/daemonprocess",
    "internal/processplatform",
    "internal/runidentity",
    "internal/terminal",
    "internal/terminalcommand",
    "internal/terminalconnector",
    "internal/tuisession"
  ],
  "generatedRoots": [
    "internal/spicegen"
  ],
  "rules": {
    "onePrimaryTypePerFile": "error",
    "methodsInPrimaryTypeFile": "error",
    "fileNameMatchesType": "error",
    "packageFunctions": "error",
    "explicitConstructors": "error",
    "explicitManagedScopes": "error",
    "banInit": "error",
    "banMutablePackageState": "error",
    "privateManagedFields": "error",
    "moduleOwnership": "error",
    "routeClassification": "error",
    "contextFirst": "error",
    "errorLast": "error",
    "maxTypeFileLines": 500
  },
  "publicRoutes": [],
  "allowedBoundaryFiles": [
    "**/doc.go",
    "**/main.go",
    "**/*_bean.go",
    "**/*_topic.go",
    "**/package_constants.go",
    "internal/architectureproof/application.go",
    "**/*_test.go",
    "internal/spicegen/**"
  ],
  "packageFunctionExceptions": [
    {
      "glob": "**/main.go",
      "symbol": "main",
      "reason": "Go process entrypoint"
    },
    {
      "glob": "**/*_bean.go",
      "contributionKind": "provider",
      "maximum": 1,
      "reason": "Exact Spice provider boundary"
    },
    {
      "glob": "**/*_topic.go",
      "contributionKind": "event-topic",
      "maximum": 1,
      "reason": "Typed Spice event topic marker"
    },
    {
      "glob": "**/*_test.go",
      "symbolPattern": "^(Test|Benchmark|Fuzz|Example|TestMain)",
      "reason": "Go testing entrypoint"
    },
    {
      "glob": "internal/architectureproof/application.go",
      "symbol": "ArchitectureProof",
      "maximum": 1,
      "reason": "Exact generated-package conformance application marker; not production application precedent"
    }
  ],
  "packageVariableExceptions": []
}
